<script type="text/javascript" src="/assets/jquery/dist/jquery.min.js"></script>
<script type="text/javascript">


$(function(){
    
    var fevd = $('#form_entered_vintage_dates');
    var ipt = 'f';
    
    /*
    * Tooltip script 
    * powered by jQuery (http://www.jquery.com)
    * 
    * written by Alen Grakalic (http://cssglobe.com)
    * 
    * for more info visit http://cssglobe.com/post/1695/easiest-tooltip-and-image-preview-using-jquery
    *
    * Modified to add live event binding.
    */

    // these 2 variable determine popup's distance from the cursor
    // you might want to adjust to get the right result    
    tt_xOffset = 10;
    tt_yOffset = 20;    
    
    $('a.tooltip').on('mouseenter', function (e) {
            this.t = this.title;
            this.title = "";
            $("body").append("<p id='tooltip'>"+ this.t +"</p>");
            $("#tooltip")
                .css("top",(e.pageY - tt_xOffset) + "px")
                .css("left",(e.pageX + tt_yOffset) + "px")
                .fadeIn("fast");        
    });
    
    $('a.tooltip').on('mouseleave', function () {
        this.title = this.t;        
        $("#tooltip").remove();
    }); 

    $('a.tooltip').on('mousemove', function(e) {
        $("#tooltip")
            .css("top",(e.pageY - tt_xOffset) + "px")
            .css("left",(e.pageX + tt_yOffset) + "px");
    });
    
    $('#form_download_data').on('click', function() {
        ga('send', 'event', 'download', 'click', document.location.pathname);
    });
  
});
</script>

