<script>
    function getCookie(name) {
        var cookies = document.cookie.split(';');
        for (var i in cookies) {
            var cookie = cookies[i].trim().split('=');
            if (cookie[0] == name) {
                return cookie[1];
            }
        }
        return null;
    }

    var appConfig = {
        uapi_host: 'https://alfred.stlouisfed.org/uapi',
        research_host: 'https://research.stlouisfed.org',
